{
  "name": "novel-studio",
  "version": "0.7.0",
  "author": "JeffGuo7",
  "private": true,
  "description": "本地优先的小说创作工作台",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:agent && electron-vite dev",
    "build": "electron-vite build && npm run build:agent",
    "build:agent": "node scripts/build-agent.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node scripts/e2e-screenshots.mjs",
    "e2e:agent": "npm run build && node scripts/e2e-assistant.mjs",
    "gen:catalog": "node scripts/gen-model-catalog.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "diff": "^8.0.0",
    "dompurify": "^3.2.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.0",
    "isomorphic-git": "1.44.4",
    "marked": "^15.0.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "lucide-react": "^1.61.0"
  }
}
