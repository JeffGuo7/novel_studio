{
  "name": "novel-studio",
  "version": "0.33.0",
  "author": "JeffGuo7",
  "private": true,
  "description": "本地优先的小说创作工作台",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:agent && electron-vite dev",
    "build": "electron-vite build && npm run build:agent",
    "build:agent": "node scripts/build-agent.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node scripts/e2e-screenshots.mjs",
    "e2e:agent": "npm run build && node scripts/e2e-assistant.mjs",
    "gen:catalog": "node scripts/gen-model-catalog.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "release": "node scripts/release.mjs",
    "e2e:window": "npm run build && node scripts/e2e-window-close.mjs",
    "e2e:budget": "npm run build && node scripts/e2e-budget-warn.mjs",
    "e2e:drift": "npm run build && node scripts/e2e-style-drift.mjs",
    "e2e:opencode": "npm run build && node scripts/e2e-opencode.mjs",
    "e2e:delete": "npm run build && node scripts/e2e-delete.mjs",
    "e2e:compact": "npm run build && node scripts/e2e-compact.mjs",
    "e2e:search": "npm run build && node scripts/e2e-search.mjs",
    "e2e:proposals": "npm run build && node scripts/e2e-proposals.mjs",
    "e2e:outline": "npm run build && node scripts/e2e-outline.mjs",
    "lint": "oxlint src tests scripts",
    "test:coverage": "vitest run --coverage",
    "bench:large": "vite-node scripts/bench-large-book.ts",
    "e2e:settings": "npm run build && node scripts/e2e-settings.mjs",
    "e2e:smoke": "npm run build && node scripts/e2e-screenshots.mjs && node scripts/e2e-settings.mjs",
    "doctor:update": "vite-node scripts/check-updater.ts",
    "eval:retrieval": "vite-node scripts/eval-retrieval.ts",
    "e2e:export": "npm run build && node scripts/e2e-export.mjs",
    "e2e:chapters": "npm run build && node scripts/e2e-chapters.mjs",
    "e2e:autosave": "npm run build && node scripts/e2e-autosave.mjs",
    "e2e:book-search": "npm run build && node scripts/e2e-book-search.mjs",
    "e2e:connection": "npm run build && node scripts/e2e-connection.mjs",
    "e2e:review": "npm run build && node scripts/e2e-review.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "adm-zip": "^0.6.1",
    "diff": "^8.0.0",
    "dompurify": "^3.2.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "isomorphic-git": "1.44.4",
    "marked": "^15.0.0",
    "minisearch": "^7.2.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "undici": "^7.30.1",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "lucide-react": "^1.61.0"
  }
}
